{
  "name": "@jasonmorganson/foundry",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonmorganson/foundry.git"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "pnpm exec npm-check-updates --deep -u && pnpm install",
    "bump-ui": "pnpm exec shadcn@latest add --all --overwrite -c packages/design-system",
    "migrate": "cd packages/database && pnpm exec prisma format && pnpm exec prisma generate && pnpm exec prisma migrate dev",
    "migrate:deploy": "cd packages/database && pnpm exec prisma generate && pnpm exec prisma migrate deploy",
    "db:push": "cd packages/database && pnpm exec prisma format && pnpm exec prisma generate && pnpm exec prisma db push",
    "clean": "git clean -xdf node_modules",
    "check:foundry": "node scripts/verify-source-ledger.mjs",
    "validate": "pnpm run check:foundry && pnpm run check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.4.6",
    "@jasonmorganson/typescript-config": "workspace:*",
    "@turbo/gen": "^2.8.14",
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "ultracite": "7.2.5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^15.0.0",
    "nypm": "^0.6.5"
  },
  "overrides": {
    "parse5": "^7.2.1"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
